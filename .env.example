# ── Local dev ────────────────────────────────────────────────────────────────
# When set, the browser calls the AI Gateway DIRECTLY using this key
# (the key gets baked into the JS bundle — only safe for localhost).
# Leave UNSET when building for production.
VITE_OPENAI_API_KEY=

# Optional override of the gateway base URL (no trailing /chat/completions).
# VITE_OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/3d275686d20e190931adbada39b35957/soda/compat

# ── Production ───────────────────────────────────────────────────────────────
# Cloudflare Turnstile public site key. Safe to ship to the browser.
# When this is set, the frontend attaches a Turnstile token to every API call.
# Get one at: https://dash.cloudflare.com → Turnstile → Add site
VITE_TURNSTILE_SITE_KEY=
